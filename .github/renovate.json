{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Every upstream release gets built: automerge everything here; homelab gates rollout.",
  "extends": [
    "config:recommended"
  ],
  "assignees": [
    "csobrinho"
  ],
  "fetchChangeLogs": "pr",
  "customDatasources": {
    "talos-factory": {
      "description": "Talos versions the image factory can build; same feed homelab upgrades Talos from",
      "defaultRegistryUrlTemplate": "https://factory.talos.dev/versions",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$.{\"version\": $}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Upstream version pinned in images/<name>/image.yaml",
      "managerFilePatterns": [
        "/^images/[^/]+/image\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+version:\\s+\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "automerge": true
}
